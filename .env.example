# ------------------------------------------------------------------
# FlowForge environment variables
# Copy this file to .env and fill in real values.
# ------------------------------------------------------------------

# --- Backend ---
PORT=4000
NODE_ENV=development

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://flowforge:flowforge@localhost:5432/flowforge?schema=public

# Redis connection (used by BullMQ queues)
REDIS_URL=redis://localhost:6379

# JWT signing secret — generate a long random value in production
JWT_SECRET=change-me-to-a-long-random-string

# Comma separated list of allowed browser origins (CORS)
WEB_ORIGIN=http://localhost:5173

# Public base URL used when displaying webhook endpoints
# Leave empty to derive it from incoming requests
WEBHOOK_BASE_URL=

# --- Email ---
# email mode: "smtp" sends real mail, "mock" logs emails to the execution log
EMAIL_MODE=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="FlowForge <no-reply@flowforge.local>"

# --- Frontend (build-time) ---
# Base URL of the API. In development the Vite dev server proxies
# /api and /socket.io to the backend, so this can stay empty.
VITE_API_URL=
